{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hotseat-replay",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "LLM_MODE": "replay",
        "DATABASE_URL": "file:./data/e2e.db",
        "MAX_TURNS": "10"
      }
    },
    {
      "name": "hotseat-live-nokeys",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "LLM_MODE": "live",
        "DATABASE_URL": "file:./data/e2e-live.db",
        "OPENCODE_API_KEY": "",
        "GEMINI_API_KEY": "",
        "GROQ_API_KEY": ""
      }
    },
    {
      "name": "hotseat-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "LLM_MODE": "live",
        "DATABASE_URL": "file:./data/live-check.db"
      }
    },
    {
      "name": "hotseat-prod-replay",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "LLM_MODE": "replay",
        "DATABASE_URL": "file:./data/e2e.db",
        "RATE_LIMIT": "on"
      }
    },
    {
      "name": "hotseat-prod-research",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "LLM_MODE": "replay",
        "DATABASE_URL": "file:./data/e2e-research.db",
        "RATE_LIMIT": "on",
        "TAVILY_API_KEY": "replay-placeholder"
      }
    },
    {
      "name": "hotseat-floor-replay",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "LLM_MODE": "replay",
        "DATABASE_URL": "file:./data/floor-e2e.db",
        "MANAGER_PASSWORD": "local-floor-test",
        "APP_SECRET": "local-floor-test-secret-0123456789",
        "BOLNA_API_KEY": ""
      }
    }
  ]
}