# ==============================================================================
# AI-Powered Role-Play Preparation Coach - Environment Variables
# ==============================================================================

# LLM API Keys (Server-side only. Never exposed to browser, never logged)
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs (Verified in Step 1 live smoke test)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Dev-only local model endpoint (e.g. Ollama OpenAI-compatible endpoint)
LOCAL_LLM_URL=

# libSQL Database Connection (Default local SQLite file)
DATABASE_URL=file:./data/app.db

# Sparring constraints
MAX_TURNS=10

# Operating mode: live (default) or replay (automated tests only, displays banner in UI)
LLM_MODE=live
