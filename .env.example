# ==============================================================================
# AI-Powered Role-Play Preparation Coach - Environment Variables
# Copy to .env.local and fill in at least one provider key.
# ==============================================================================

# LLM API keys (server-side only; never sent to the browser).
# Tried in order: OpenCode Go -> Gemini -> Groq -> local. Any one key is enough.
# OpenCode Go -> https://opencode.ai/auth   Gemini -> https://aistudio.google.com/app/apikey   Groq -> https://console.groq.com/keys
OPENCODE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs are read only from here (no defaults in code). Run `npm run llm:smoke` to confirm they work.
OPENCODE_MODEL=deepseek-v4.1-flash
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# OpenCode Go OpenAI-compatible endpoint (default shown; override only if it moves)
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Optional live company research at the briefing step (https://app.tavily.com). Leave empty to turn it off.
TAVILY_API_KEY=
# Live research runs per day across all visitors (cached repeats don't count). 30/day stays under Tavily's ~1,000-credit free plan.
RESEARCH_DAILY_LIMIT=30

# Optional dev-only local OpenAI-compatible endpoint, tried last (e.g. Ollama)
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

# libSQL database. Local file by default; for Turso use libsql://<db>.turso.io plus an auth token.
# Tables are created automatically on the first request.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Default user-turn cap per sparring session (2-30)
MAX_TURNS=10

# live (default) or replay (serves fixtures/llm/*.json; used by tests, shows a banner in the UI)
LLM_MODE=live

# --- Public deployment protection ---
# Per-IP request limits on every API route (on/off). Keep "on" for any public deployment.
RATE_LIMIT=on
# Max AI-backed requests per UTC day from all visitors combined, so rotating IPs can't drain your keys.
GLOBAL_DAILY_LLM_LIMIT=500
# Max AI-backed requests per minute from all visitors combined, to stay under the providers' own per-minute limits.
GLOBAL_LLM_PER_MINUTE=30
